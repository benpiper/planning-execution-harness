{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "BootstrapPlan",
  "description": "Ordered preparation phases before main execution loop",
  "type": "object",
  "required": ["phases"],
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "enum": [
          "cli_entry",
          "system_prompt_fastpath",
          "mcp_fastpath",
          "daemon_worker_fastpath",
          "main_runtime"
        ]
      },
      "description": "Ordered list of bootstrap phases"
    }
  }
}
